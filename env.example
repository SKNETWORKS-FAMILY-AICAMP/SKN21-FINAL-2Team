# [Project Root] Infrastructure & Common API Keys Example

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# LangSmith (Tracing & Debugging)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT="SKN21_final_2Team"

# LLM Model Configuration
# =============================================

# 🤖 일반 LLM (챗봇, 대답 생성 등) - 기본값: OpenAI
# LLM_MODEL: 사용할 LLM 모델명
#   - "gpt-4o-mini" (OpenAI, 권장)
LLM_MODEL=gpt-4o-mini

# LLM_TYPE: LLM 프로바이더
#   - "openai" (기본값, OpenAI API 사용, 권장)
LLM_TYPE=openai

# OLLAMA_BASE_URL: Ollama 서버 주소 (LLM_TYPE=ollama일 때만 필요)
# Docker Compose: http://ollama:11434
# 로컬 실행: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# =============================================
# 🖼️  OCR 전용 LLM (예약정보 추출) - 기본값: Ollama
# 챗봇과 독립적으로 설정 가능
# =============================================

# OCR_LLM_MODEL: OCR 필드 추출에 사용할 모델명
#   - "qwen2.5:3b" (Ollama, 권장, 개인정보 보호)
#   - "gpt-4o-mini" (OpenAI, 빨지만 비용 증가)
OCR_LLM_MODEL=qwen2.5:3b

# OCR_LLM_TYPE: OCR용 LLM 프로바이더
#   - "ollama" (기본값, 권장, 로컬 실행)
#   - "openai" (선택, OpenAI API)
OCR_LLM_TYPE=ollama

# OCR_OLLAMA_BASE_URL: Ollama 서버 주소 (OCR 전용)
# Docker Compose: http://ollama:11434
# 로컬 실행: http://localhost:11434
OCR_OLLAMA_BASE_URL=http://localhost:11434

# MySQL Configuration (Docker Container)
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_DATABASE=skn_db
MYSQL_USER=skn_user
MYSQL_PASSWORD=your_user_password
MYSQL_HOST=mysql
MYSQL_PORT=3306
