# OpenAI
OPENAI_API_KEY=your_openai_api_key

# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=your_project_name

# Tavily
TAVILY_API_KEY=your_tavily_api_key

# Hugging Face
HF_TOKEN=your_hf_token

# MySQL
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=skn_db
MYSQL_USER=skn_user
MYSQL_PASSWORD=skn_password
MYSQL_HOST=mysql
# MYSQL_PORT=3306

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Google Login
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
JWT_SECRET_KEY=your_jwt_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=2000
REFRESH_TOKEN_EXPIRE_DAYS=7

# Naver Map
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# CORS
CORS_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1,http://127.0.0.1:3000,https://triver-s.com,https://www.triver-s.com
# 필요 시 서브도메인 패턴 허용 (예: https://.*\\.triver-s\\.com)
CORS_ORIGIN_REGEX=

# S3 (AWS)
FILE_SERVER_URL=s3://your-bucket/public/
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-northeast-2
S3_PUBLIC_BASE_URL=https://your-bucket.s3.ap-northeast-2.amazonaws.com/public

# Google Vision API
GOOGLE_VISION_API_KEY=your_google_vision_api_key

# ODsay 대중교통 API (https://lab.odsay.com)
ODSAY_API_KEY=your_odsay_api_key
